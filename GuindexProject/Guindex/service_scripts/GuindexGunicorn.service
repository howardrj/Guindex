[Unit]
Description=Guindex Gunicorn HTTP Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/Guindex/GuindexProject
ExecStart=/usr/local/bin/gunicorn --workers 3 --bind unix:/var/www/Guindex/GuindexProject/Guindex.sock --capture-output --log-level info --access-logfile - --error-logfile - GuindexProject.wsgi:application
User=guindex
Group=guindex
Restart=always
RestartSec=1
StartLimitBurst=0

[Install]
WantedBy=multi-user.target
