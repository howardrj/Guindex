[Unit]
Description=Monitor Guindex Alerts
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/Guindex/GuindexProject
ExecStart=/usr/bin/python /var/www/Guindex/GuindexProject/manage.py GuindexAlerts
User=guindex
Group=guindex
# Restart on crash, but not when the command exits cleanly (e.g. lock already held)
Restart=on-failure
RestartSec=5
StartLimitBurst=0

[Install]
WantedBy=multi-user.target
